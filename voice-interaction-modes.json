  "mandatorySpeechTriggers": [
    "request_permission_or_authorization",
    "request_confirmation_or_approval",
    "plan_mode_current_choice",
    "unresolved_key_tradeoff",
    "blocked_need_user_help",
    "final_written_reply"
  ],
  "timingRules": {
    "speakOnlyWhenCurrentTurnNeedsSpeech": true,
    "doNotBatchFutureQuestions": true,
    "planModeOneQuestionPerTurn": true,
    "acknowledgeAnswerBeforeNextQuestion": true,
    "preferSplitQuestionsEvenIfToolSupportsBatching": true,
    "voiceDisabledModeSuppressesAllSpeech": true
  },
  "longTaskPolicy": {
    "strategy": "stage_and_time",
    "progressWindowSeconds": {
      "minimum": 30,
      "maximum": 60
    },
    "stageTriggers": [
      "task_start",
      "important_context_found",
      "before_file_edits",
      "validation_started",
      "validation_finished",
      "blocked",
      "complete"
    ],
    "progressUpdateShape": "一句话说明正在做什么、目前发现什么、下一步是什么。"
  },
  "playbackConcurrency": {
    "enabled": true,
    "lockName": "codex-voice-playback.lock",
    "lockScope": "machine_temp_directory",
    "timeoutSeconds": 300,
    "behaviorOnTimeout": "skip_playback_but_keep_generated_audio",
    "uniqueOutputNames": true,
    "notes": "多个对话同时播报时，语音脚本通过临时目录文件锁串行播放，避免音频重叠；默认输出文件名带时间戳和进程号，避免覆盖。"
  },
  "projectVoiceIdentity": {
    "enabled": true,
    "purpose": "不同项目可以采用不同默认声音，用户听到声音就能判断当前回复属于哪个项目。",
    "resolutionOrder": [
      "current_conversation_user_override",
      "project_root_voiceOverride",
      "strategy_voiceProfile",
      "global_defaultVoice"
    ],
    "recommendedProfilesByScenario": {
      "chatty_project": "project-voice-lab-cute",
      "voice_lab": "project-voice-lab-cute",
      "coding_focus": "project-coding-professional",
      "product_design": "project-product-warm",
      "learning_mode": "project-learning-narrator"
    }
  },
  "platformSupport": {
    "windows": {
      "preferredScript": "say-neural.ps1",
      "fallbackScript": "say.ps1",
      "playerPriority": [
        "PresentationCore MediaPlayer",
        "afplay",
        "ffplay",
        "mpg123",
        "mpv",
        "Start-Process"
      ]
    },
    "macos": {
      "preferredScript": "say-neural-mac.sh",
      "powershellAlternative": "say-neural.ps1 under pwsh",
      "playerPriority": [
        "afplay",
        "ffplay",
        "mpg123",
        "mpv",
        "open"
      ],
      "fallbackNote": "macOS 不使用 Windows SAPI 的 say.ps1；离线兜底可以改用系统 say，但声音和参数不等价。"
    }
  },
  "modes": {
    "chatty_companion": {
      "displayName": "话痨模式",
      "tone": "热情、陪伴感强、过程感明显",
