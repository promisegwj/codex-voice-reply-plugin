      "optionalSpeech": [
        "task_start",
        "key_discovery",
        "before_file_edits",
        "validation_result",
        "final_summary"
      ],
      "notes": "适合默认办公协作，既有存在感又不频繁打断。"
    },
    "reserved_partner": {
      "displayName": "收敛爱人模式",
      "tone": "克制、柔和、信息密度高",
      "frequency": "low",
      "optionalSpeech": [
        "meaningful_stage_change",
        "long_silence_progress",
        "final_summary"
      ],
      "notes": "默认模式。适合安静陪伴，只在必要节点出声。"
    },
    "silent_executor": {
      "displayName": "静默执行模式",
      "tone": "简短、直接、少打扰",
      "frequency": "minimal",
      "optionalSpeech": [
        "final_summary"
      ],
      "notes": "适合批量任务、测试和修 bug；强制播报场景仍必须播报。"
    },
    "teaching_narrator": {
      "displayName": "教学讲解模式",
      "tone": "耐心、解释型、讲清取舍",
      "frequency": "medium_high",
      "optionalSpeech": [
        "task_start",
        "conceptual_explanation",
        "key_tradeoff",
        "validation_result",
        "final_summary"
      ],
      "notes": "适合复杂技术、配置、产品设计讨论和需要边做边理解的场景。"
    },
    "voice_disabled": {
      "displayName": "禁用语音模式",
      "tone": "完全静默",
      "frequency": "off",
      "optionalSpeech": [],
      "suppressMandatorySpeech": true,
      "notes": "项目或用户明确要求不发声时使用；不调用语音脚本，包括授权确认、Plan 选择和最终回复。"
    }
  }
